rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn() && request.auth.token.email == 'tkdvofinance@gmail.com';
    }

    function isGroupMember(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'group'
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.group == groupId;
    }

    function validGroup(groupId) {
      return groupId in [
        'Buhangin', 'Bunawan', 'Calinan', 'Indangan', 'JP Laurel', 'Mandug',
        'Marilog', 'Mintal', 'Panacan', 'Ponciano', 'Samal', 'Sandawa',
        'Toril', 'Mentors'
      ];
    }

    match /userProfiles/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'group'
        && request.resource.data.status == 'pending'
        && validGroup(request.resource.data.group)
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == userId || isAdministrator());
      allow update: if isAdministrator()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.group == resource.data.group
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email);
      allow delete: if isAdministrator();
    }

    match /groups/{groupId}/{document=**} {
      allow read, write: if validGroup(groupId) && (isAdministrator() || isGroupMember(groupId));
    }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdministrator();
    }
  }
}
